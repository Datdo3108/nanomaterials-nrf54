/ {
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};

	aliases {
		spi-controller = &spi21;
	};

	buttons {
		power_button: powerbutton {
			gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
			label = "POWER BUTTON";
		};
	};
	
	leds {
        ad5761_sync: ad5761sync {
            gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>;
            label = "AD5761 SYNC";
        };

		ad5761_ldac: ad5761ldac {
            gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
            label = "AD5761 LDAC";
		};

		ad5761_reset: ad5761reset {
            gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
            label = "AD5761 RESET";
		};

		ad5761_sync_ii: ad5761sync_ii {
            gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
            label = "AD5761 II SYNC";
        };

		ad5761_ldac_ii: ad5761ldac_ii {
            gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;
            label = "AD5761 II LDAC";
		};

		ad5761_reset_ii: ad5761reset_ii {
            gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>;
            label = "AD5761 II RESET";
		};

		sw_in_1: sw_in1 {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			label = "Analog switch SW1 Pin";
		};

		sw_in_2: sw_in2 {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			label = "Analog switch SW2 Pin";
		};
    };
};

&led0 {
	status = "disabled";
};

&led1 {
	status = "disabled";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

&button0 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

&button2 {
	status = "disabled";
};

&button3 {
	status = "disabled";
};

&pinctrl {
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 6)>,
					<NRF_PSEL(SPIM_MISO, 2, 9)>,
					<NRF_PSEL(SPIM_MOSI, 2, 8)>;
		};
	};

	spi21_sleep: spi21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 6)>;
		};
	};
};

&spi21 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;

	gendev: gendev@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1600000>;
		label = "GenDev";
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
    status = "okay";

    // Ids
    channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN6>;	/* P1.13 */
		// zephyr,input-negative = <NRF_SAADC_AIN2>;	/* P1.06 */
		zephyr,resolution = <12>;
	};

    // Drain Voltage VD
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_EXTERNAL0";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN5>;       /* P1.12 */
        zephyr,resolution = <12>;
    };

    // Gate Voltage VG
    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_EXTERNAL0";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN7>;    /* P1.14 */
        zephyr,resolution = <12>;
    };
};

// &uart20 {
// 	status = "disabled";
// };

&spi00 {
	status = "disabled";
};


