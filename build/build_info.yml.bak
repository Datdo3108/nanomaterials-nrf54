cmake:
  application:
    source-dir: 'C:/ncs/v3.1.1/zephyr/share/sysbuild'
  board:
    name: 'nrf54l15dk'
    path:
     - 'C:/ncs/v3.1.1/zephyr/boards/nordic/nrf54l15dk'
    qualifiers: 'nrf54l10/cpuapp'
    revision: ''
  images:
   - name: 'lmp91000_board'
     source-dir: 'E:/Projects/nanomaterials-nrf54/lmp91000_board'
     type: 'MAIN'
  kconfig:
    files:
     - 'E:/Projects/nanomaterials-nrf54/lmp91000_board/build/_sysbuild/empty.conf'
     - 'E:/Projects/nanomaterials-nrf54/lmp91000_board/build/_sysbuild/empty.conf'
    user-files:
     - 'E:/Projects/nanomaterials-nrf54/lmp91000_board/build/_sysbuild/empty.conf'
  sysbuild: 'true'
version: '0.1.0'
west:
  command: 'C:\ncs\toolchains\c1a76fddb2\opt\bin\Scripts\west build --build-dir e:/Projects/nanomaterials-nrf54/lmp91000_board/build e:/Projects/nanomaterials-nrf54/lmp91000_board --pristine --board nrf54l15dk/nrf54l10/cpuapp -- -DCONF_FILE=prj.conf -DDEBUG_THREAD_INFO=On -DCONFIG_DEBUG_THREAD_INFO=y -Dlmp91000_board_DEBUG_THREAD_INFO=On'
  topdir: 'c:\ncs\v3.1.1'
  version: '1.4.0'
